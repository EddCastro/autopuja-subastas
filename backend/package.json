{
  "name": "autopuja-api",
  "version": "1.0.0",
  "description": "API REST + tiempo real (Socket.IO) para subastas de vehículos. Express + SQL Server.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "demo": "node scripts/demo.js",
    "db:migrar": "node scripts/migrar.js",
    "db:semilla": "node scripts/semilla.js",
    "db:preparar": "node scripts/migrar.js && node scripts/semilla.js",
    "test": "node --test",
    "test:sqlserver": "node tests/prepararBdPruebas.js && TEST_REPO=sqlserver node --test --test-concurrency=1"
  },
  "author": "Eddy Adolfo Castro Véliz <1890-23-16857>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^11.0.2",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0"
  }
}
