# Copie este archivo como .env y complete los valores (el .env NO se sube a GitHub).
PORT=3000

# --- SQL Server ---
DB_SERVER=
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# Opcional: prefijo para las tablas si la base de datos es compartida (ej. AP_)
DB_TABLE_PREFIX=

# --- Seguridad ---
# Clave larga y aleatoria para firmar los tokens de sesión (JWT)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos (frontend). * = cualquiera
CORS_ORIGINS=*
